<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0" PrivateAssets="all" />
    <!-- The real catalog and file associations of Kazo OS read the manifest BoxedWine ships. -->
    <PackageReference Include="Kazo.Os.Platform.Core" Version="$(KazoOsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BoxedWine\BoxedWine.csproj" />
    <ProjectReference Include="..\..\src\BoxedWine.Lib\BoxedWine.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest.json the build wrote (with the permission of build/FeaturePermissions.targets). -->
    <None Include="..\..\src\BoxedWine\manifest.json" Link="shipped\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
